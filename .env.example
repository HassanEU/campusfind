# =============================================================================
# CampusFind :: environment template
#
#   cp .env.example .env
#
# .env is git-ignored.  Never commit real secrets.
# The host ports below were chosen to avoid clashing with anything already
# running on this machine (a local postgres on 5432, other stacks on 8080 ...).
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=campusfind
POSTGRES_PASSWORD=change_me_in_your_local_env
POSTGRES_DB=campusfind
POSTGRES_PORT=55432

# --- pgAdmin -----------------------------------------------------------------
PGADMIN_EMAIL=admin@campusfind.edu
PGADMIN_PASSWORD=change_me_in_your_local_env
PGADMIN_PORT=5051

# --- API ---------------------------------------------------------------------
API_PORT=4001
# Generate a real one with:  openssl rand -hex 48
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5174

# --- Web ---------------------------------------------------------------------
WEB_PORT=5174
# Leave as /api so the browser talks to the same host (nginx or Vite proxies it).
# Override only if the API is hosted on a different origin.
VITE_API_URL=/api
# Public origin encoded into printed QR labels. Leave empty to use the host
# the browser is currently on (localhost, LAN IP, or deployed hostname).
PUBLIC_APP_URL=
